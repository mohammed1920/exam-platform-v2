rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled != false;
    }

    match /students/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /examResults/{resultId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
                  && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /lawyerApplications/{applicationId} {
      allow create: if signedIn()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.id == applicationId
                    && request.resource.data.identityVerification == 'external_whatsapp_or_telegram';
      allow read: if isAdmin() || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.applicantUid == request.auth.uid && resource.data.status == 'pending');
    }

    match /lawyerEditRequests/{requestId} {
      allow create: if signedIn()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.applicationId is string
                    && request.resource.data.profileId is string
                    && request.resource.data.data is map;
      allow read: if isAdmin() || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /lawyerProfiles/{profileId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /leaderboards/{bookId}/entries/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.bookId == bookId
                    && request.resource.data.finalScore >= 0
                    && request.resource.data.finalScore <= 1000
                    && request.resource.data.rankingScore >= -1
                    && request.resource.data.rankingScore <= 1000
                    && request.resource.data.completedChapters >= 0;

      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.bookId == bookId
                    && request.resource.data.finalScore >= 0
                    && request.resource.data.finalScore <= 1000
                    && request.resource.data.rankingScore >= -1
                    && request.resource.data.rankingScore <= 1000
                    && request.resource.data.completedChapters >= 0;

      allow delete: if false;
    }

    match /mizanArticles/{articleId} {
      allow read: if isAdmin()
                  || resource.data.status == 'published';

      allow create: if isAdmin()
                    || (
                      signedIn()
                      && exists(/databases/$(database)/documents/mizanContributors/$(request.auth.uid))
                      && get(/databases/$(database)/documents/mizanContributors/$(request.auth.uid)).data.status == 'approved'
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.status == 'pending'
                    );

      allow update, delete: if isAdmin();
    }

    match /mizanContributors/{userId} {
      allow read: if isAdmin()
                  || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.userUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin()
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.userUid == request.auth.uid
                      && request.resource.data.status == resource.data.status
                    );

      allow delete: if isAdmin();
    }

    match /mizanContributorPublic/{userId} {
      allow read: if resource.data.status == 'approved' && resource.data.fullName is string;
      allow create, update: if isAdmin()
                            || (signedIn()
                            && request.auth.uid == userId
                            && request.resource.data.fullName is string
                            && request.resource.data.role is string
                            && request.resource.data.specialization is string
                            && request.resource.data.bio is string);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}