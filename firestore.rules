rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled != false;
    }

    match /students/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /lawyerApplications/{applicationId} {
      allow create: if signedIn()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.id == applicationId
                    && request.resource.data.identityVerification == 'external_whatsapp_or_telegram';
      allow read: if isAdmin() || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.applicantUid == request.auth.uid && resource.data.status == 'pending');
    }

    match /lawyerEditRequests/{requestId} {
      allow create: if signedIn()
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.applicationId is string
                    && request.resource.data.profileId is string
                    && request.resource.data.data is map;
      allow read: if isAdmin() || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /lawyerProfiles/{profileId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /mizanArticles/{articleId} {
      allow read: if isAdmin()
                  || resource.data.status == 'published'
                  || (signedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isAdmin()
                    || (
                      signedIn()
                      && exists(/databases/$(database)/documents/mizanContributors/$(request.auth.uid))
                      && get(/databases/$(database)/documents/mizanContributors/$(request.auth.uid)).data.status == 'approved'
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.status == 'pending'
                    );

      allow update: if isAdmin()
                    || (
                      signedIn()
                      && resource.data.authorUid == request.auth.uid
                      && request.resource.data.authorUid == resource.data.authorUid
                      && request.resource.data.status == resource.data.status
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['title', 'type', 'excerpt', 'content', 'updatedAt'])
                    );

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /mizanContributors/{userId} {
      allow read: if isAdmin()
                  || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.userUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin()
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.userUid == request.auth.uid
                      && request.resource.data.status == resource.data.status
                    );

      allow delete: if isAdmin();
    }

    match /mizanContributorPublic/{userId} {
      allow read: if resource.data.status == 'approved' && resource.data.fullName is string;

      // Only admins can create/approve a public contributor profile.
      allow create: if isAdmin();

      // An approved contributor may edit profile fields, but cannot change
      // the approval state or add privileged fields.
      allow update: if isAdmin()
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && resource.data.status == 'approved'
                      && request.resource.data.status == resource.data.status
                      && request.resource.data.fullName is string
                      && request.resource.data.role is string
                      && request.resource.data.specialization is string
                      && request.resource.data.bio is string
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['fullName', 'role', 'specialization', 'bio', 'updatedAt'])
                    );

      allow delete: if isAdmin();
    }


    // Access requests for the protected legal procedures section.
    match /procedureAccessRequests/{userId} {
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() >= 10
                    && request.resource.data.reason.size() <= 1000
                    && request.resource.data.displayName is string
                    && request.resource.data.email is string
                    && request.resource.data.keys().hasOnly([
                      'uid', 'displayName', 'email', 'reason', 'status', 'createdAt', 'updatedAt'
                    ]);

      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow update: if isAdmin()
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && resource.data.uid == request.auth.uid
                      && resource.data.status in ['rejected', 'revoked']
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.reason is string
                      && request.resource.data.reason.size() >= 10
                      && request.resource.data.reason.size() <= 1000
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'displayName', 'email', 'reason', 'status', 'updatedAt'
                      ])
                    );

      allow delete: if isAdmin();
    }

    // The grant is authoritative. Only an admin may grant or revoke access.
    match /procedureAccess/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Public catalog exposes only procedure IDs and titles; only admins can update it.
    match /publicIndexes/procedures {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Procedure documents and legal details remain protected.
    match /legalProcedures/{procedureId} {
      allow read: if isAdmin()
                  || (
                    signedIn()
                    && resource.data.published == true
                    && exists(/databases/$(database)/documents/procedureAccess/$(request.auth.uid))
                    && get(/databases/$(database)/documents/procedureAccess/$(request.auth.uid)).data.enabled == true
                  );
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}