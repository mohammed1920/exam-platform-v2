    {
      "uid": "JI-2023-CIVIL-LAW-002",
      "id": 2,
      "type": "essay",
      "text": "تكلم عن كل مما يأتي في ضوء نصوص واحكام القانون المدني العراقي:",
      "parts": [
        {
          "label": "1 - قضاة",
          "text": "الحالات التي تنتهي فيها الكفالة."
        },
        {
          "label": "2 - قضاة",
          "text": "خيار التعيين."
        },
        {
          "label": "3 - قضاة",
          "text": "هلاك العقار المرهون رهنا تأمينياً."
        },
        {
          "label": "4 - قضاة",
          "text": "شروط استرداد الحيازة."
        },
        {
          "label": "5 - قضاة",
          "text": "المقايضة."
        }
      ],
