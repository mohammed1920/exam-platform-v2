  "questions": [
    {
      "uid": "JI-2023-CIVIL-LAW-001",
      "id": 1,
      "type": "essay",
      "text": "ما هو حكم القانون المدني العراقي في الاحوال التالية:",
      "parts": [
        {
          "label": "1 - قضاة",
          "text": "تجاوز النائب حدود السلطات الممنوحة له في القانون او الاتفاق والاستثناءات التي ترد عليه."
        },
        {
          "label": "2 - قضاة",
          "text": "سريان العقد في حق الغير معززا اجابتك بأمثلة عملية."
        },
        {
          "label": "3 - قضاة",
          "text": "انقضاء الالتزام باستحالة التنفيذ."
        },
        {
          "label": "4 - قضاة",
          "text": "اقتران العقد باجل مبينا متى يسقط حق المدين في الاجل."
        },
        {
          "label": "5 - قضاة",
          "text": "ضمان العيوب الموجودة في المأجور."
        }
      ],
      "options": [],
      "answer": "",
      "explanation": "",
      "legalReferences": [],
