  "subjectName": "القانون المدني",
  "questions": [
    {
      "uid": "JI-2021-CIVIL-LAW-001",
      "id": 1,
      "type": "essay",
      "text": "تكلم بإيجاز غير مخل عن كل مما يأتي:",
      "parts": [
        {
          "label": "1",
          "text": "احكام غصب المأجور"
        },
        {
          "label": "2",
          "text": "استعمال الوديع للوديعة والتصرف بها."
        },
        {
          "label": "3",
          "text": "الاثار المترتبة على الحكم بالحجز على المدين."
        },
        {
          "label": "4",
          "text": "حكم الفوائد القانونية على الثمن المستحق الاداء في عقد البيع."
        },
        {
          "label": "5",
          "text": "العلاقة بين المحال عليه والمحيل في حوالة الدين المطلقة."
        },
        {
          "label": "6",
          "text": "متى يعتبر السكوت قبولا."
        },
        {
          "label": "7",
          "text": "حقوق رب العمل عند تنفيذ اعمال المقاولة على وجه معيب او مناف للعقد."
        },
        {
          "label": "8",
          "text": "انقضاء حق المنفعة بهلاك الشيء."
        },
        {
          "label": "9",
          "text": "كيفية تعيين التعويض في المسؤولية عن الاعمال غير المشروعة."
        },
        {
          "label": "10",
          "text": "سريان النصوص الجديدة المتعلقة بالتقادم."
        }
      ],
