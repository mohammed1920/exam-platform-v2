{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-petition-index.mjs",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/pulpit/:id",
      "destination": "/api/article?id=:id"
    }
  ],
  "functions": {
    "api/search-questions.js": {
      "includeFiles": "data/search-index.json"
    }
  }
}
