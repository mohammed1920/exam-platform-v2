rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.enabled != false;
    }

    // Sensitive Bar Association ID documents are private by default.
    // The applicant may upload/read only their own file; admins may review it.
    match /lawyerApplications/{uid}/{applicationId}/bar-id {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid && firestore.get(/databases/(default)/documents/lawyerApplications/$(applicationId)).data.status == 'pending');
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && firestore.get(/databases/(default)/documents/lawyerApplications/$(applicationId)).data.status == 'pending'
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf'];
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && firestore.get(/databases/(default)/documents/lawyerApplications/$(applicationId)).data.status == 'pending');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
